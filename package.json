{
  "name": "ics-suite",
  "version": "0.0.1",
  "description": "Parse, query, validate and diff .ics calendar files",
  "author": "Ahmad Souqi",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "prepublish": "pnpm build && publint",
    "release": "changeset publish"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "temporal-polyfill": "^0.3.2"
  },
  "keywords": [
    "ics",
    "ical",
    "icalendar",
    "rfc5545",
    "vcalendar",
    "vevent",
    "calendar",
    "parser",
    "query",
    "validator",
    "diff",
    "recurrence",
    "rrule",
    "recurring-events",
    "calendar-sync",
    "timezone",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asouqi/ics-suite.git"
  }
}