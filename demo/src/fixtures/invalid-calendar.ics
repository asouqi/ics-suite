BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Broken App//Calendar Export 1.0//EN
CALSCALE:GREGORIAN
BEGIN:VEVENT
DTSTAMP:20240101T080000Z
CREATED:20240101T080000Z
DTSTART;TZID=America/New_York:20240115T090000
DTEND;TZID=America/New_York:20240115T100000
SUMMARY:Team meeting — missing UID
DESCRIPTION:This event is missing its UID property which is required
  by RFC 5545 Section 3.6.1.
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:reversed-times@broken.example.com
DTSTAMP:20240101T080000Z
CREATED:20240101T080000Z
DTSTART;TZID=America/New_York:20240120T150000
DTEND;TZID=America/New_York:20240120T140000
SUMMARY:Meeting with reversed times
DESCRIPTION:This event has DTEND before DTSTART — a direct violation
  of RFC 5545 Section 3.8.2.2.
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:both-count-and-until@broken.example.com
DTSTAMP:20240101T080000Z
CREATED:20240101T080000Z
DTSTART;TZID=America/New_York:20240101T090000
DTEND;TZID=America/New_York:20240101T100000
SUMMARY:Recurring event with both COUNT and UNTIL
DESCRIPTION:This RRULE has both COUNT and UNTIL which is prohibited
  by RFC 5545 Section 3.3.10.
RRULE:FREQ=DAILY;COUNT=10;UNTIL=20240131T090000Z
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:bad-priority@broken.example.com
DTSTAMP:20240101T080000Z
CREATED:20240101T080000Z
DTSTART;TZID=America/New_York:20240125T110000
DTEND;TZID=America/New_York:20240125T120000
SUMMARY:Event with invalid PRIORITY
DESCRIPTION:PRIORITY must be between 0 and 9 per RFC 5545 Section
  3.8.1.9. This event has PRIORITY:15.
PRIORITY:15
STATUS:CONFIRMED
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT15M
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:alarm-missing-description@broken.example.com
DTSTAMP:20240101T080000Z
CREATED:20240101T080000Z
DTSTART;TZID=America/New_York:20240128T140000
DTEND;TZID=America/New_York:20240128T150000
SUMMARY:Event with invalid alarm
DESCRIPTION:This event has a VALARM with ACTION:DISPLAY but no
  DESCRIPTION — required by RFC 5545 Section 3.6.6.
STATUS:CONFIRMED
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT10M
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:wrong-status@broken.example.com
DTSTAMP:20240101T080000Z
CREATED:20240101T080000Z
DTSTART;TZID=America/New_York:20240130T100000
DTEND;TZID=America/New_York:20240130T110000
SUMMARY:Event with invalid STATUS value
DESCRIPTION:NEEDS-ACTION is a valid status for VTODO but not for
  VEVENT. RFC 5545 Section 3.8.1.11 defines TENTATIVE\, CONFIRMED\,
  and CANCELLED as the only valid values for VEVENT.
STATUS:NEEDS-ACTION
END:VEVENT
END:VCALENDAR
